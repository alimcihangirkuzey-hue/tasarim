asir); kullanilmayan alan eklemek kaldirilan olu sozlesmeyi geri acmak olurdu"],"risk_class":"orta"},"prev":null,"hash":"6ba892857ef77ebaadb8044fdc228ec1326df5c6f53491d87d39642cbc960c37"}
